{
  "manifest_version": 3,
  "name": "ytModify",
  "version": "0.0.0",
  "description": "Auto pop-out, Deep Dark look, bigger player and ambient light for YouTube, in one extension.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "ytModify",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "look/look-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*"
      ],
      "run_at": "document_start",
      "js": [
        "pip/pip-main.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*"
      ],
      "run_at": "document_start",
      "js": [
        "pip/pip-isolated.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "look/images/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
